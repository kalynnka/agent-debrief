{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Debrief",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        // The row tick's menu (`multiDiffEditor/resource/title`) is proposed API.
        // Development mode alone is meant to admit it, but the switch is what
        // makes it deterministic — and it drops the "EXTENSION WILL BE BROKEN"
        // line the dev-mode path logs instead.
        "--enable-proposed-api=octoverse.debrief",
        "${workspaceFolder}/../octoverse.code-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: watch"
    },
    {
      // For the one-window setup: `pnpm dev` opens the octoverse workspace with
      // debrief already running in it, and holds port 9229 open. This attaches
      // to that window's extension host.
      //
      // Run it from a *different* window. The JS debugger is itself an extension
      // living in the host you are pausing, so attaching to your own window and
      // hitting a breakpoint stops the debugger along with the extension.
      "name": "Attach to Debrief",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
