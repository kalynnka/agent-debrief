{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Debrief",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        // What the host opens: this project, so the extension is exercised
        // against its own repo — but wrapped in a workspace file, not named as a
        // folder. A folder gets one window, and this folder is already open in
        // the window F5 runs from, so handed the bare path the host cannot take
        // it and comes up with whatever it last restored. The workspace file is
        // its own window identity and opens alongside.
        // It has to stay the only bare argument in here. `--enable-proposed-api`
        // used to sit directly above it, and that switch takes a list of
        // extension IDs — given none, it read this path as the ID and the host
        // came up with no folder at all. Nothing needs the switch now: the row
        // tick's `multiDiffEditor/resource/title` menu was the only proposed API
        // this extension contributed, and that menu is gone.
        "${workspaceFolder}/.vscode/debrief.code-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "watch"
    }
  ]
}
