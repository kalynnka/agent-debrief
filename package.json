{
  "name": "octoview",
  "displayName": "Octoview",
  "description": "Snapshot-by-snapshot review of agent changes: snapshot each turn, diff snapshot-over-snapshot, batch line comments.",
  "version": "0.0.1",
  "publisher": "octoverse",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "bin": {
    "octoview": "./out/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "//enabledApiProposals": "The tick on a multi-diff row's own toolbar. Development-only: VS Code allows a proposed API for an extension run from source, so this build cannot be published as-is, and a VS Code update can withdraw the proposal — the button disappears, everything else keeps working.",
  "enabledApiProposals": [
    "contribMultiDiffEditorMenus"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "octoview",
          "title": "Octoview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "octoview": [
        {
          "id": "octoview.snapshots",
          "name": "Snapshots",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "octoview.snapshots",
        "contents": "No snapshots yet in this workspace. A snapshot is captured when an agent finishes its turn, or you can take one now.\n[Take Snapshot](command:octoview.snapshot)"
      }
    ],
    "commands": [
      {
        "command": "octoview.snapshot",
        "title": "Take Snapshot",
        "category": "Octoview",
        "icon": "$(device-camera)"
      },
      {
        "command": "octoview.refresh",
        "title": "Refresh",
        "category": "Octoview",
        "icon": "$(refresh)"
      },
      {
        "command": "octoview.stackedDiff",
        "title": "Open Net Diff of Selected Snapshots",
        "category": "Octoview",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "octoview.stepHistory",
        "title": "Open Step History",
        "category": "Octoview",
        "icon": "$(history)"
      },
      {
        "command": "octoview.submit",
        "title": "Submit Review",
        "category": "Octoview",
        "icon": "$(check-all)"
      },
      {
        "command": "octoview.markReviewed",
        "title": "Mark Reviewed",
        "category": "Octoview",
        "icon": "$(check)"
      },
      {
        "command": "octoview.markUnreviewed",
        "title": "Mark Unreviewed",
        "category": "Octoview",
        "icon": "$(remove)"
      },
      {
        "command": "octoview.createThread",
        "title": "Add Review Comment",
        "category": "Octoview"
      },
      {
        "command": "octoview.replyThread",
        "title": "Reply",
        "category": "Octoview"
      },
      {
        "command": "octoview.deleteThread",
        "title": "Delete Thread",
        "category": "Octoview",
        "icon": "$(trash)"
      },
      {
        "command": "octoview.openFile",
        "title": "Open File",
        "category": "Octoview",
        "icon": "$(go-to-file)"
      },
      {
        "command": "octoview.revert",
        "title": "Revert This Snapshot's Change",
        "category": "Octoview",
        "icon": "$(discard)"
      },
      {
        "command": "octoview.dropSnapshot",
        "title": "Drop This Snapshot",
        "category": "Octoview",
        "icon": "$(trash)"
      },
      {
        "command": "octoview.openSnapshot",
        "title": "Open Snapshot Diff",
        "category": "Octoview"
      },
      {
        "command": "octoview.markViewedHere",
        "title": "Mark Viewed",
        "category": "Octoview",
        "icon": "$(check)"
      },
      {
        "command": "octoview.markUnviewedHere",
        "title": "Mark Not Viewed",
        "category": "Octoview",
        "icon": "$(remove)"
      },
      {
        "command": "octoview.markAllReviewed",
        "title": "Mark All Files Viewed",
        "category": "Octoview",
        "icon": "$(checklist)"
      },
      {
        "command": "octoview.markAllUnreviewed",
        "title": "Mark All Files Not Viewed",
        "category": "Octoview",
        "icon": "$(clear-all)"
      },
      {
        "command": "octoview.commitReviewed",
        "title": "Commit Reviewed Snapshots",
        "category": "Octoview",
        "icon": "$(git-commit)"
      },
      {
        "command": "octoview.toggleRowViewed",
        "title": "Mark Viewed / Not Viewed",
        "category": "Octoview",
        "icon": "$(check)"
      },
      {
        "command": "octoview.openNote",
        "title": "Read the Whole Note",
        "category": "Octoview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "octoview.markViewedHere",
          "when": "octoview.inDiff && !octoview.diffViewed",
          "group": "navigation@1"
        },
        {
          "command": "octoview.markUnviewedHere",
          "when": "octoview.inDiff && octoview.diffViewed",
          "group": "navigation@1"
        },
        {
          "command": "octoview.markAllReviewed",
          "when": "octoview.inReview && !octoview.reviewAllViewed",
          "group": "navigation@1"
        },
        {
          "command": "octoview.markAllUnreviewed",
          "when": "octoview.inReview && octoview.reviewAllViewed",
          "group": "navigation@1"
        },
        {
          "command": "octoview.submit",
          "when": "octoview.inReview",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "octoview.snapshot",
          "when": "view == octoview.snapshots",
          "group": "navigation@1"
        },
        {
          "command": "octoview.stackedDiff",
          "when": "view == octoview.snapshots",
          "group": "navigation@3"
        },
        {
          "command": "octoview.submit",
          "when": "view == octoview.snapshots",
          "group": "navigation@4"
        },
        {
          "command": "octoview.refresh",
          "when": "view == octoview.snapshots",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "octoview.commitReviewed",
          "when": "view == octoview.snapshots && viewItem == group-reviewed",
          "group": "inline@1"
        },
        {
          "command": "octoview.openFile",
          "when": "view == octoview.snapshots && viewItem =~ /^file-/",
          "group": "inline@1"
        },
        {
          "command": "octoview.revert",
          "when": "view == octoview.snapshots && (viewItem =~ /-revertable$/ || viewItem =~ /^snapshot-(un)?reviewed-droppable$/)",
          "group": "inline@2"
        },
        {
          "command": "octoview.dropSnapshot",
          "when": "view == octoview.snapshots && viewItem == snapshot-frozen-droppable",
          "group": "inline@2"
        },
        {
          "command": "octoview.markReviewed",
          "when": "view == octoview.snapshots && (viewItem =~ /^file-unreviewed/ || viewItem =~ /^snapshot-unreviewed/)",
          "group": "inline@3"
        },
        {
          "command": "octoview.markUnreviewed",
          "when": "view == octoview.snapshots && (viewItem =~ /^file-reviewed/ || viewItem =~ /^snapshot-reviewed/)",
          "group": "inline@4"
        },
        {
          "command": "octoview.stepHistory",
          "when": "view == octoview.snapshots && viewItem =~ /^file-/",
          "group": "octoview@1"
        }
      ],
      "multiDiffEditor/resource/title": [
        {
          "command": "octoview.toggleRowViewed",
          "when": "octoview.inReview && resourceScheme != octoview-note",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "octoview.openFile",
          "when": "false"
        },
        {
          "command": "octoview.toggleRowViewed",
          "when": "false"
        },
        {
          "command": "octoview.openNote",
          "when": "false"
        },
        {
          "command": "octoview.revert",
          "when": "false"
        },
        {
          "command": "octoview.dropSnapshot",
          "when": "false"
        },
        {
          "command": "octoview.openSnapshot",
          "when": "false"
        },
        {
          "command": "octoview.markViewedHere",
          "when": "octoview.inDiff && !octoview.diffViewed"
        },
        {
          "command": "octoview.markUnviewedHere",
          "when": "octoview.inDiff && octoview.diffViewed"
        },
        {
          "command": "octoview.markAllReviewed",
          "when": "octoview.inReview"
        },
        {
          "command": "octoview.markAllUnreviewed",
          "when": "octoview.inReview"
        },
        {
          "command": "octoview.commitReviewed",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "octoview.createThread",
          "group": "inline@1",
          "when": "commentController == octoview"
        },
        {
          "command": "octoview.replyThread",
          "group": "inline@2",
          "when": "commentController == octoview && commentThreadIsEmpty == false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "octoview.deleteThread",
          "group": "navigation",
          "when": "commentController == octoview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "octoview.markViewedHere",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "octoview.inDiff && !octoview.diffViewed"
      },
      {
        "command": "octoview.markUnviewedHere",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "octoview.inDiff && octoview.diffViewed"
      }
    ],
    "configuration": {
      "title": "Octoview",
      "properties": {
        "octoview.author": {
          "type": "string",
          "default": "reviewer",
          "description": "Name recorded on review comments."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node test/smoke.js && node test/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
