{
  "name": "octoview",
  "displayName": "Octoview",
  "description": "Snapshot-by-snapshot review of agent changes: snapshot each turn, diff snapshot-over-snapshot, batch line comments.",
  "version": "0.0.1",
  "publisher": "octoverse",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "bin": {
    "octoview": "./out/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "octoview",
          "title": "Octoview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "octoview": [
        {
          "id": "octoview.snapshots",
          "name": "Snapshots",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "octoview.snapshots",
        "contents": "No snapshots yet in this workspace. A snapshot is captured when an agent finishes its turn, or you can take one now.\n[Take Snapshot](command:octoview.snapshot)"
      }
    ],
    "commands": [
      {
        "command": "octoview.snapshot",
        "title": "Take Snapshot",
        "category": "Octoview",
        "icon": "$(device-camera)"
      },
      {
        "command": "octoview.refresh",
        "title": "Refresh",
        "category": "Octoview",
        "icon": "$(refresh)"
      },
      {
        "command": "octoview.stackedDiff",
        "title": "Open Net Diff of Selected Snapshots",
        "category": "Octoview",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "octoview.stepHistory",
        "title": "Open Step History",
        "category": "Octoview",
        "icon": "$(history)"
      },
      {
        "command": "octoview.submit",
        "title": "Submit Review",
        "category": "Octoview",
        "icon": "$(check-all)"
      },
      {
        "command": "octoview.copyReview",
        "title": "Copy Review for the Agent",
        "category": "Octoview",
        "icon": "$(clippy)"
      },
      {
        "command": "octoview.sendReviewToTerminal",
        "title": "Send Review to the Agent's Terminal",
        "category": "Octoview",
        "icon": "$(terminal)"
      },
      {
        "command": "octoview.createThread",
        "title": "Add Review Comment",
        "category": "Octoview"
      },
      {
        "command": "octoview.replyThread",
        "title": "Reply",
        "category": "Octoview"
      },
      {
        "command": "octoview.deleteThread",
        "title": "Delete Thread",
        "category": "Octoview",
        "icon": "$(trash)"
      },
      {
        "command": "octoview.openFile",
        "title": "Open File",
        "category": "Octoview",
        "icon": "$(go-to-file)"
      },
      {
        "command": "octoview.revert",
        "title": "Revert This Snapshot's Change",
        "category": "Octoview",
        "icon": "$(discard)"
      },
      {
        "command": "octoview.dropSnapshot",
        "title": "Drop This Snapshot",
        "category": "Octoview",
        "icon": "$(trash)"
      },
      {
        "command": "octoview.openSnapshot",
        "title": "Open Snapshot Diff",
        "category": "Octoview"
      },
      {
        "command": "octoview.openNote",
        "title": "Read the Whole Note",
        "category": "Octoview"
      },
      {
        "command": "octoview.gc",
        "title": "Let Go of Abandoned Lanes",
        "category": "Octoview",
        "icon": "$(trash)"
      },
      {
        "command": "octoview.clearLane",
        "title": "Delete This Branch's Snapshots",
        "category": "Octoview",
        "icon": "$(trash)"
      },
      {
        "command": "octoview.showMore",
        "title": "Show Earlier Commits",
        "category": "Octoview",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "octoview.submit",
          "when": "octoview.inReview",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "octoview.refresh",
          "when": "view == octoview.snapshots",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "octoview.snapshot",
          "when": "view == octoview.snapshots && viewItem =~ /^repo/",
          "group": "inline@1"
        },
        {
          "command": "octoview.stackedDiff",
          "when": "view == octoview.snapshots && viewItem =~ /^repo/",
          "group": "inline@2"
        },
        {
          "command": "octoview.submit",
          "when": "view == octoview.snapshots && viewItem =~ /^repo/",
          "group": "inline@3"
        },
        {
          "command": "octoview.copyReview",
          "when": "view == octoview.snapshots && viewItem =~ /^repo/",
          "group": "inline@4"
        },
        {
          "command": "octoview.gc",
          "when": "view == octoview.snapshots && viewItem == repo-abandoned",
          "group": "inline@5"
        },
        {
          "command": "octoview.openFile",
          "when": "view == octoview.snapshots && viewItem =~ /^file-/",
          "group": "inline@1"
        },
        {
          "command": "octoview.revert",
          "when": "view == octoview.snapshots && (viewItem =~ /-revertable$/ || viewItem =~ /^snapshot-(un)?reviewed-droppable$/)",
          "group": "inline@2"
        },
        {
          "command": "octoview.dropSnapshot",
          "when": "view == octoview.snapshots && viewItem == snapshot-frozen-droppable",
          "group": "inline@2"
        },
        {
          "command": "octoview.stepHistory",
          "when": "view == octoview.snapshots && viewItem =~ /^file-/",
          "group": "octoview@1"
        },
        {
          "command": "octoview.sendReviewToTerminal",
          "when": "view == octoview.snapshots && viewItem =~ /^repo/",
          "group": "octoview@1"
        },
        {
          "command": "octoview.clearLane",
          "when": "view == octoview.snapshots && viewItem =~ /^repo/",
          "group": "octoview@2"
        }
      ],
      "commandPalette": [
        {
          "command": "octoview.openFile",
          "when": "false"
        },
        {
          "command": "octoview.openNote",
          "when": "false"
        },
        {
          "command": "octoview.revert",
          "when": "false"
        },
        {
          "command": "octoview.dropSnapshot",
          "when": "false"
        },
        {
          "command": "octoview.openSnapshot",
          "when": "false"
        },
        {
          "command": "octoview.gc",
          "when": "false"
        },
        {
          "command": "octoview.clearLane",
          "when": "false"
        },
        {
          "command": "octoview.showMore",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "octoview.createThread",
          "group": "inline@1",
          "when": "commentController == octoview"
        },
        {
          "command": "octoview.replyThread",
          "group": "inline@2",
          "when": "commentController == octoview && commentThreadIsEmpty == false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "octoview.deleteThread",
          "group": "navigation",
          "when": "commentController == octoview && commentThreadIsEmpty == false"
        }
      ]
    },
    "configuration": {
      "title": "Octoview",
      "properties": {
        "octoview.author": {
          "type": "string",
          "default": "",
          "description": "Name recorded on review comments. Empty uses the repository's git user.name, which is what every other record of this work carries."
        }
      }
    }
  },
  "scripts": {
    "dev": "code -n --extensionDevelopmentPath=\"$PWD\" --enable-proposed-api=octoverse.octoview --inspect-extensions=9229 ../octoverse.code-workspace",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node test/smoke.js && node test/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
