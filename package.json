{
  "name": "octoview",
  "displayName": "Octoview",
  "description": "Turn-by-turn review of agent changes: snapshot each turn, diff turn-over-turn, batch line comments.",
  "version": "0.0.1",
  "publisher": "octoverse",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "bin": {
    "octoview": "./out/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "octoview",
          "title": "Octoview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "octoview": [
        {
          "id": "octoview.turns",
          "name": "Turns"
        }
      ]
    },
    "commands": [
      {
        "command": "octoview.snapshot",
        "title": "Snapshot Turn",
        "category": "Octoview",
        "icon": "$(device-camera)"
      },
      {
        "command": "octoview.refresh",
        "title": "Refresh",
        "category": "Octoview",
        "icon": "$(refresh)"
      },
      {
        "command": "octoview.stackedDiff",
        "title": "Open Stacked Diff of Checked Turns",
        "category": "Octoview",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "octoview.submit",
        "title": "Submit Review",
        "category": "Octoview",
        "icon": "$(check-all)"
      },
      {
        "command": "octoview.markReviewed",
        "title": "Mark Reviewed",
        "category": "Octoview",
        "icon": "$(check)"
      },
      {
        "command": "octoview.markUnreviewed",
        "title": "Mark Unreviewed",
        "category": "Octoview",
        "icon": "$(circle-outline)"
      },
      {
        "command": "octoview.createThread",
        "title": "Add Review Comment",
        "category": "Octoview"
      },
      {
        "command": "octoview.replyThread",
        "title": "Reply",
        "category": "Octoview"
      },
      {
        "command": "octoview.deleteThread",
        "title": "Delete Thread",
        "category": "Octoview",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "octoview.snapshot",
          "when": "view == octoview.turns",
          "group": "navigation@1"
        },
        {
          "command": "octoview.submit",
          "when": "view == octoview.turns",
          "group": "navigation@2"
        },
        {
          "command": "octoview.stackedDiff",
          "when": "view == octoview.turns",
          "group": "navigation@3"
        },
        {
          "command": "octoview.refresh",
          "when": "view == octoview.turns",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "octoview.markReviewed",
          "when": "view == octoview.turns && viewItem == file-unreviewed",
          "group": "inline"
        },
        {
          "command": "octoview.markUnreviewed",
          "when": "view == octoview.turns && viewItem == file-reviewed",
          "group": "inline"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "octoview.createThread",
          "group": "inline@1",
          "when": "commentController == octoview"
        },
        {
          "command": "octoview.replyThread",
          "group": "inline@2",
          "when": "commentController == octoview && commentThreadIsEmpty == false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "octoview.deleteThread",
          "group": "navigation",
          "when": "commentController == octoview"
        }
      ]
    },
    "configuration": {
      "title": "Octoview",
      "properties": {
        "octoview.author": {
          "type": "string",
          "default": "reviewer",
          "description": "Name recorded on review comments."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node test/smoke.js && node test/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
