{
  "name": "agent-debrief",
  "displayName": "Agent Debrief",
  "description": "Snapshot-by-snapshot review of agent changes: snapshot each turn, diff snapshot-over-snapshot, batch line comments.",
  "version": "0.0.1",
  "publisher": "octoverse",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "bin": {
    "debrief": "./out/cli.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debrief",
          "title": "Debrief",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "debrief": [
        {
          "id": "debrief.repositories",
          "name": "Repositories",
          "icon": "media/icon.svg",
          "when": "debrief.manyRepos"
        },
        {
          "id": "debrief.snapshots",
          "name": "Snapshots",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "debrief.snapshots",
        "contents": "No snapshots yet in this workspace. A snapshot is captured when an agent finishes its turn, or you can take one now.\n[Take Snapshot](command:debrief.snapshot)",
        "when": "!debrief.reposHidden"
      },
      {
        "view": "debrief.snapshots",
        "contents": "Some repositories are unchecked in the Repositories view, so their snapshots are not shown here.\n[Show All Repositories](command:debrief.showAllRepos)",
        "when": "debrief.reposHidden"
      }
    ],
    "commands": [
      {
        "command": "debrief.snapshot",
        "title": "Take Snapshot",
        "category": "Debrief",
        "icon": "$(device-camera)"
      },
      {
        "command": "debrief.refresh",
        "title": "Refresh",
        "category": "Debrief",
        "icon": "$(refresh)"
      },
      {
        "command": "debrief.showAllRepos",
        "title": "Show All Repositories",
        "category": "Debrief",
        "icon": "$(check-all)"
      },
      {
        "command": "debrief.stackedDiff",
        "title": "Open Net Diff of Selected Snapshots",
        "category": "Debrief",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "debrief.stepHistory",
        "title": "Open Step History",
        "category": "Debrief",
        "icon": "$(history)"
      },
      {
        "command": "debrief.submit",
        "title": "Submit Review",
        "category": "Debrief",
        "icon": "$(check-all)"
      },
      {
        "command": "debrief.copyReview",
        "title": "Copy Review for the Agent",
        "category": "Debrief",
        "icon": "$(clippy)"
      },
      {
        "command": "debrief.sendReviewToTerminal",
        "title": "Send Review to the Agent's Terminal",
        "category": "Debrief",
        "icon": "$(terminal)"
      },
      {
        "command": "debrief.createThread",
        "title": "Add Review Comment",
        "category": "Debrief"
      },
      {
        "command": "debrief.replyThread",
        "title": "Reply",
        "category": "Debrief"
      },
      {
        "command": "debrief.deleteThread",
        "title": "Delete Thread",
        "category": "Debrief",
        "icon": "$(trash)"
      },
      {
        "command": "debrief.openDiff",
        "title": "Open This File's Diff",
        "category": "Debrief",
        "icon": "$(diff-single)"
      },
      {
        "command": "debrief.openFile",
        "title": "Open File",
        "category": "Debrief",
        "icon": "$(go-to-file)"
      },
      {
        "command": "debrief.revert",
        "title": "Revert This Snapshot's Change",
        "category": "Debrief",
        "icon": "$(discard)"
      },
      {
        "command": "debrief.dropSnapshot",
        "title": "Drop This Snapshot",
        "category": "Debrief",
        "icon": "$(trash)"
      },
      {
        "command": "debrief.openSnapshot",
        "title": "Open Snapshot Diff",
        "category": "Debrief"
      },
      {
        "command": "debrief.openNote",
        "title": "Read the Whole Note",
        "category": "Debrief"
      },
      {
        "command": "debrief.gc",
        "title": "Let Go of Abandoned Lanes",
        "category": "Debrief",
        "icon": "$(trash)"
      },
      {
        "command": "debrief.clearLane",
        "title": "Delete This Branch's Snapshots",
        "category": "Debrief",
        "icon": "$(trash)"
      },
      {
        "command": "debrief.showMore",
        "title": "Show Earlier Commits",
        "category": "Debrief",
        "icon": "$(ellipsis)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "debrief.submit",
          "when": "debrief.inReview",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "debrief.refresh",
          "when": "view == debrief.snapshots",
          "group": "navigation@1"
        },
        {
          "command": "debrief.showAllRepos",
          "when": "view == debrief.repositories && debrief.reposHidden",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "debrief.snapshot",
          "when": "view == debrief.snapshots && viewItem =~ /^repo/",
          "group": "inline@1"
        },
        {
          "command": "debrief.stackedDiff",
          "when": "view == debrief.snapshots && viewItem =~ /^repo/",
          "group": "inline@2"
        },
        {
          "command": "debrief.submit",
          "when": "view == debrief.snapshots && viewItem =~ /^repo/",
          "group": "inline@3"
        },
        {
          "command": "debrief.copyReview",
          "when": "view == debrief.snapshots && viewItem =~ /^repo/",
          "group": "inline@4"
        },
        {
          "command": "debrief.gc",
          "when": "view == debrief.snapshots && viewItem == repo-abandoned",
          "group": "inline@5"
        },
        {
          "command": "debrief.openFile",
          "when": "view == debrief.snapshots && viewItem =~ /^file-/",
          "group": "inline@1"
        },
        {
          "command": "debrief.revert",
          "when": "view == debrief.snapshots && (viewItem =~ /-revertable$/ || viewItem =~ /^snapshot-(un)?reviewed-droppable$/)",
          "group": "inline@2"
        },
        {
          "command": "debrief.dropSnapshot",
          "when": "view == debrief.snapshots && viewItem == snapshot-frozen-droppable",
          "group": "inline@2"
        },
        {
          "command": "debrief.stepHistory",
          "when": "view == debrief.snapshots && viewItem =~ /^file-/",
          "group": "debrief@1"
        },
        {
          "command": "debrief.sendReviewToTerminal",
          "when": "view == debrief.snapshots && viewItem =~ /^repo/",
          "group": "debrief@1"
        },
        {
          "command": "debrief.clearLane",
          "when": "view == debrief.snapshots && viewItem =~ /^repo/",
          "group": "debrief@2"
        }
      ],
      "commandPalette": [
        {
          "command": "debrief.createThread",
          "when": "false"
        },
        {
          "command": "debrief.replyThread",
          "when": "false"
        },
        {
          "command": "debrief.deleteThread",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "debrief.createThread",
          "group": "inline@1",
          "when": "commentController == debrief"
        },
        {
          "command": "debrief.replyThread",
          "group": "inline@2",
          "when": "commentController == debrief && commentThreadIsEmpty == false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "debrief.deleteThread",
          "group": "navigation",
          "when": "commentController == debrief && commentThreadIsEmpty == false"
        }
      ]
    },
    "configuration": {
      "title": "Debrief",
      "properties": {
        "debrief.author": {
          "type": "string",
          "default": "",
          "description": "Name recorded on review comments. Empty uses the repository's git user.name, which is what every other record of this work carries."
        }
      }
    }
  },
  "scripts": {
    "dev": "code -n --extensionDevelopmentPath=\"$PWD\" --inspect-extensions=9229 \"$PWD\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node test/smoke.js && node test/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
