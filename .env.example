# Copy to .env and fill in. .env is gitignored and excluded from both published
# artifacts; this file carries the names and no values.
#
# These are the same two names to add under
#   GitHub -> Settings -> Secrets and variables -> Actions
# so the local copy and the pipeline's copy are called the same thing.
#
# docs/RELEASING.md is where each one comes from.

# Azure DevOps PAT, scope Marketplace > Manage, organization "All accessible
# organizations". The pipeline hands this to vsce as VSCE_PAT; to publish by hand:
#   export VSCE_PAT="$(grep '^MARKETPLACE_PAT=' .env | cut -d= -f2-)"
MARKETPLACE_PAT=

# npm granular token with read+write on the package, or a classic Automation token.
# A classic Publish token prompts for 2FA, which no CI run can answer.
NPM_TOKEN=
